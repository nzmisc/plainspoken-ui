{
  "name": "plainspoken-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plain, dense, accessible React components, distributed as a shadcn registry.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-registry.mjs --index && next dev",
    "build": "npm run registry:build && npm run storybook:build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "storybook": "storybook dev -p 6106 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build -o public/storybook --quiet",
    "icons": "node scripts/copy-lucide.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.5"
  }
}
