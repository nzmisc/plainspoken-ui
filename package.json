{
  "name": "plainspoken-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plain, dense, accessible React components, distributed as a shadcn registry.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/build-registry.ts --index && next dev",
    "build": "node scripts/build-theme.ts --check && npm run registry:build && npm run storybook:build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "registry:build": "node --env-file-if-exists=.env.production.local scripts/build-registry.ts",
    "theme:build": "node scripts/build-theme.ts",
    "storybook": "storybook dev -p 6106 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build -o public/storybook --quiet",
    "icons": "node scripts/copy-lucide.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.157",
    "@milkdown/kit": "^7.22.3",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "ai": "^7.0.153",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-math": "^6.0.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.5"
  }
}
