          "success": "oklch(0.724 0.162 143.7)",
          "warning": "oklch(0.749 0.142 76.5)"
        }
      },
      "css": {
        "@utility ctl-xs": {
          "--ctl-h": "20px",
          "--ctl-px": "6px",
          "--ctl-inset": "4px",
          "--ctl-text": "12px",
          "--ctl-gap": "4px",
          "--ctl-icon": "12px"
        },
        "@utility ctl-sm": {
          "--ctl-h": "24px",
          "--ctl-px": "8px",
          "--ctl-inset": "6px",
          "--ctl-text": "13px",
          "--ctl-gap": "6px",
          "--ctl-icon": "14px"
        },
        "@utility ctl-md": {
          "--ctl-h": "28px",
          "--ctl-px": "10px",
          "--ctl-inset": "8px",
          "--ctl-text": "14px",
          "--ctl-gap": "6px",
          "--ctl-icon": "16px"
        },
        "@utility ctl-lg": {
          "--ctl-h": "36px",
          "--ctl-px": "14px",
          "--ctl-inset": "10px",
          "--ctl-text": "16px",
          "--ctl-gap": "8px",
          "--ctl-icon": "18px"
        },
        "@layer base": {
          ":root": {
            "--ctl-h": "28px",
            "--ctl-px": "10px",
            "--ctl-inset": "8px",
            "--ctl-text": "14px",
            "--ctl-gap": "6px",
            "--ctl-icon": "16px"
          }
        }
      },
