          "path": "registry/plainspoken/lib/controls.ts",
          "type": "registry:lib"
        }
      ],
      "cssVars": {
        "theme": {
          "color-link": "var(--link)",
          "color-link-visited": "var(--link-visited)",
          "color-success": "var(--success)",
          "color-warning": "var(--warning)",
          "spacing-ctl-xs": "20px",
          "spacing-ctl-sm": "24px",
          "spacing-ctl-md": "28px",
          "spacing-ctl-lg": "36px"
        },
        "light": {
          "link": "oklch(0.429 0.297 264.1)",
          "link-visited": "oklch(0.378 0.172 302.2)",
          "success": "oklch(0.508 0.153 142.9)",
          "warning": "oklch(0.542 0.124 62.5)"
        },
        "dark": {
          "link": "oklch(0.766 0.108 259.8)",
